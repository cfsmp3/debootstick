# vim: filetype=sh

usage_and_exit()
{
    echo "Usage: debootstick [options] <fs_tree_dir> <out_image_path>" >&2
    exit $1
}

# options which need a value
option_requires_value()
{
    case "$1" in
        --kernel-package|--config-kernel-bootargs|--config-hostname|\
        --system-type|--disk-layout|--sector-size|--run-on-first-boot)
            return 0    # yes
            ;;
    esac
    return 1            # no
}

# called by parse_args() for options which do not accept a value
reject_attached_value()
{
    if [ "$option_value_attached" = 1 ]
    then
        echo "Option '$option' does not accept a value. Exiting." >&2
        exit 1
    fi
}

describe_os_support()
{
    cat << EOF
This version of debootstick was tested successfully with the following kinds of
chroot-environments:
* 32-bit arm Raspberry Pi:
    - Raspberry Pi OS (formerly "rasbian") bullseye
* 64-bit amd64 systems:
    - Debian 13 (trixie) as of September 2nd, 2025
    - Debian 12 (bookworm)
    - Debian 11 (bullseye)
    - Ubuntu 22.10 (kinetic)
    - Ubuntu 22.04 LTS (jammy)
EOF
}
