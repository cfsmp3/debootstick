# vim: filetype=sh

# print the path of the OS description file of the given tree.
# as specified in os-release(5), /etc/os-release is read, or
# /usr/lib/os-release if the former does not exist.
get_os_release_file()
{
    fs_tree="$1"
    for os_release_file in etc/os-release usr/lib/os-release
    do
        if [ -f "$fs_tree/$os_release_file" ]
        then
            echo "$fs_tree/$os_release_file"
            return 0
        fi
    done
    return 1
}

# check if the given OS description file reports a debian-like OS:
# its ID is 'debian', or 'debian' is one of the words of its ID_LIKE list.
# (the file is read in a subshell, so that its variables do not
# override ours.)
is_debian_like()
(
    os_release_file="$1"
    ID=""
    ID_LIKE=""
    . "$os_release_file"
    [ "$ID" = "debian" ] && exit 0
    set -f  # do not expand words of ID_LIKE as file name patterns
    IFS="$(printf ' \t\n\r\v\f')"  # words are separated by any whitespace
    for id_like in $ID_LIKE
    do
        [ "$id_like" = "debian" ] && exit 0
    done
    exit 1
)

# check that the given directory looks like an OS
# file structure that we can handle correctly.
check_fs_hierarchy()
{
    fs_tree="$1"
    level="$2"
    case "$level" in
    "1")
        if [ ! -f "$fs_tree/bin/echo" ]
        then
            echo "E: No /bin/echo found in $fs_tree."
            echo "E: This does not seem to be a valid chroot environment. Aborting."
            return 1
        fi

        os_release_file="$(get_os_release_file "$fs_tree")" || {
            echo "E: No /etc/os-release or /usr/lib/os-release file found in $fs_tree."
            echo "E: Cannot check compatibility. Aborting."
            return 1
        }

        if ! is_debian_like "$os_release_file"
        then
            echo "E: ${os_release_file#"$fs_tree"} file in $fs_tree does not report a debian-like OS."
            echo "E: This chroot environment is not supported by debootstick.  Aborting." >&2
            echo "E: Run 'debootstick --help-os-support' for a list of supported chroot environments."
            return 1
        fi
        ;;
    "2")
        chroot "$fs_tree" echo -n >/dev/null 2>&1 || {
            echo "E: Unable to execute binaries (/bin/echo at least) in the chroot environment. Aborting."
            echo "E: Please verify:"
            echo "E: - file permissions in the chroot environment"
            echo "E: - that your host CPU is able to run binaries of the target architecture"
            echo "E: Run 'debootstick --help-os-support' for info about compatible environments."
            return 1
        }
        chroot "$fs_tree" which apt-get >/dev/null 2>&1 || {
            echo "E: No apt-get found in $1."
            echo "E: This chroot environment is not supported by debootstick.  Aborting."
            echo "E: Run 'debootstick --help-os-support' for more info."
            return 1
        }
        ;;
    esac
}

detect_target_type()
{
    fs_tree="$1"
    dir="$DBSTCK_DIR/scripts/create-image/target"
    for subdir in $(ls "$dir")
    do
        "$dir/$subdir/detect.sh" "$fs_tree" >/dev/null && {
            echo "$subdir"
            return
        }
    done
    echo "E: This chroot environment is not supported by debootstick.  Aborting." >&2
    echo "E: Run 'debootstick --help-os-support' for a list of supported chroot environments." >&2
}
